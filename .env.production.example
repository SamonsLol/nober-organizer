# Copiar a .env.production en el servidor y completar.
# Compose lo lee con: docker compose --env-file .env.production up -d --build

# Base de datos (contenedor propio, no se expone fuera de Docker)
POSTGRES_USER=nober
POSTGRES_DB=nober
# Generar con: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Zona horaria del colegio (afecta «hoy», plazos y clases)
TZ=America/Bogota

# Tamaño máximo de cada archivo subido (MB). El proxy debe aceptar al menos esto (nginx: client_max_body_size)
MAX_UPLOAD_MB=25

# Puerto local donde el proxy (nginx, Caddy…) encuentra la app (solo 127.0.0.1)
APP_PORT=3100

# Autenticación
# URL pública exacta de la app, con https
BETTER_AUTH_URL=https://organizador.midominio.com
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Después de crear tu cuenta, cerrar el registro:
AUTH_DISABLE_SIGNUP=false
# Opcional: «Continuar con Google» y sincronizar con Google Calendar (pasos en deploy/README.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Licencia AGPLv3: la app enlaza a su código fuente. Si publicas una versión modificada, pon aquí tu repositorio
# (vacío = el repositorio original).
NEXT_PUBLIC_SOURCE_URL=

# Apuntes en Obsidian (opcional). Ruta en el servidor de la bóveda (la carpeta que tiene .obsidian/);
# se monta en el contenedor y la app crea, lee y edita ahí las notas de cada clase. Debe poder escribirla el uid 1000.
# La sincronización con tus dispositivos la hace Obsidian (LiveSync, Sync, Syncthing…).
OBSIDIAN_VAULT_DIR=
# Nombre de la bóveda en Obsidian (para los enlaces obsidian://). Por defecto, el nombre de la carpeta.
OBSIDIAN_VAULT_NAME=
# Carpeta de los apuntes de clase dentro de la bóveda: <raíz>/<materia>/<fecha> <clase>.md
OBSIDIAN_NOTES_ROOT=Apuntes
# Carpeta de los proyectos (Proyectos en la app): <raíz>/<proyecto>/
OBSIDIAN_PROJECTS_ROOT=Proyectos
# Cuentas que pueden usar la bóveda (separadas por comas). Vacío = cualquier cuenta con sesión.
OBSIDIAN_ALLOWED_EMAILS=
# Recordatorios push (opcional). Generar una vez con:
#   docker run --rm node:24-alpine npx -y web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push: la URL pública de la app (o mailto:...)
VAPID_SUBJECT=https://organizador.midominio.com

# IA (opcional): también se configura desde la app en Ajustes → IA (tiene prioridad sobre esto).
# Groq, OpenAI o cualquier API compatible con OpenAI. Basta con la clave: el proveedor se deduce de ella.
#  - Groq (capa gratuita, sin tarjeta): clave «gsk_…» de https://console.groq.com/keys → modelo openai/gpt-oss-120b
#  - OpenAI (de pago): clave «sk-…» de https://platform.openai.com/api-keys → modelo gpt-5-mini
#  - Otro (OpenRouter, Ollama, LM Studio…): AI_BASE_URL + AI_MODEL (el modelo debe admitir respuestas con esquema JSON)
AI_API_KEY=
# AI_PROVIDER=groq            # groq | openai | custom (si la clave no lo deja claro)
# AI_MODEL=openai/gpt-oss-120b
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_REASONING_EFFORT=low     # para modelos que razonan (gpt-oss, gpt-5, o3…)
# AI_MAX_INPUT_CHARS=14000    # texto máximo por solicitud (Groq gratis: 14000; OpenAI: 48000)

# Obsidian en el navegador (opcional, p. ej. el contenedor de linuxserver/obsidian) para el botón «Abrir Obsidian»
OBSIDIAN_WEB_URL=
