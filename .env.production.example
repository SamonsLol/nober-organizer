# Copiar a .env.production en el servidor y completar.
# Compose lo lee con: docker compose --env-file .env.production up -d --build

# Base de datos (contenedor propio, no se expone fuera de Docker)
POSTGRES_USER=nober
POSTGRES_DB=nober
# Generar con: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Zona horaria del colegio (afecta «hoy», plazos y clases)
TZ=America/Bogota

# Tamaño máximo de cada archivo subido (MB). El proxy debe aceptar al menos esto (nginx: client_max_body_size)
MAX_UPLOAD_MB=25

# Puerto local donde el proxy (nginx, Caddy…) encuentra la app (solo 127.0.0.1)
APP_PORT=3100

# Autenticación
# URL pública exacta de la app, con https
BETTER_AUTH_URL=https://organizador.midominio.com
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Después de crear tu cuenta, cerrar el registro:
AUTH_DISABLE_SIGNUP=false
# Opcional: inicio de sesión con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AFFiNE (se fija al compilar la imagen). Autoalojado en el mismo dominio para que el panel embebido tenga sesión.
# El espacio es el id que aparece en la URL de AFFiNE: /workspace/<id>/…
NEXT_PUBLIC_AFFINE_ORIGIN=https://notas.midominio.com
NEXT_PUBLIC_AFFINE_WORKSPACE=
