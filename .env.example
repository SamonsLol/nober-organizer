# Copiar a .env. Sin DATABASE_URL la app usa los datos ficticios (lib/mock).
DATABASE_URL="postgresql://academic:academic@localhost:5433/academic_os"
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# URL pública de la app (en producción, p. ej. https://organizador.midominio.com)
BETTER_AUTH_URL="http://localhost:3000"
# Opcional (inicio de sesión con Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Orígenes extra (IP de VPN/LAN con puerto), separados por comas
TRUSTED_ORIGINS=""
# AFFiNE (se fija al compilar). El espacio es el id que aparece en la URL: /workspace/<id>/…
NEXT_PUBLIC_AFFINE_ORIGIN="https://app.affine.pro"
NEXT_PUBLIC_AFFINE_WORKSPACE=""
