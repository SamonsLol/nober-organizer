# Copiar a .env. Sin DATABASE_URL la app usa los datos ficticios (lib/mock).
DATABASE_URL="postgresql://nober:nober@localhost:5433/nober_dev"
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# URL pública de la app (en producción, p. ej. https://organizador.midominio.com)
BETTER_AUTH_URL="http://localhost:3000"
# Opcional (inicio de sesión con Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Orígenes extra (IP de VPN/LAN con puerto), separados por comas
TRUSTED_ORIGINS=""
# IA (opcional): cualquier API compatible con OpenAI. Por defecto Groq (capa gratuita, sin tarjeta):
# crea la clave en https://console.groq.com/keys
AI_API_KEY=""
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b

# Apuntes en Obsidian: carpeta de tu bóveda (la que tiene .obsidian/). Vacía = sin bóveda (modo demostración).
OBSIDIAN_VAULT_PATH=""
# Nombre de la bóveda en Obsidian (para los enlaces obsidian://). Por defecto, el nombre de la carpeta.
OBSIDIAN_VAULT_NAME=""
# Carpeta de los apuntes de clase dentro de la bóveda: <raíz>/<materia>/<fecha> <clase>.md
OBSIDIAN_NOTES_ROOT="Apuntes"
# Carpeta de los proyectos (Proyectos en la app): <raíz>/<proyecto>/
OBSIDIAN_PROJECTS_ROOT="Proyectos"
